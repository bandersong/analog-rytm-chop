-# The CHOP build's mod (`make chop`: 0000 0001 0002 0003). It excludes 0008 and
-# 0004: the same four page hosts and the same `cave` claim. Everything - code, page
-# data, strings and the 28 B of RAM state at the end - fits in `cave`; nothing in
-# cave3. Every expect below was re-read from build/stock_mainos.bin with python
-# (corp r2 builder, 2026-10-05). Receipts: mods/0001-chop/design.md.
+# The Sample Focus image A mod (`make samplefocus` = `make chop-min`: 0000 0001, tag
+# 0000_0001). The round-4 `make chop` (0000 0001 0002 0003) is retired. It excludes
+# 0008 and 0004 (the same four page hosts and the same `cave` claim) and 0002 (its
+# cave2 claim below is 0002's). Two claims: `cave` (.text: the gates, the pad gates,
+# chop_set_sta, the page data, STR's value rows and, at the end, the 48 B of RAM state,
+# 0x402a1fc0..0x402a1ff0) and `cave2` (.cave2: the step lock, the Sample Focus code and
+# the strings; no run-time state); nothing in cave3, cave4..6. The expects were first
+# re-read from build/stock_mainos.bin with python (corp r2 builder, 2026-10-05);
+# build.py checks every detour and patch expect against the stock MAIN OS on each
+# build. Receipts: mods/0001-chop/design.md.
 
 [[cave]]
 owner   = "0001-chop"
 addr    = 0x402a1b30
 size    = 0x4d0
 section = ".text"
-note    = "The page_info / get / delta / text gates, the SAMPLE key gate, the pad note-on and note-off gates, the held-trig lock gate, chop_set_sta, the knob values and clamp, the SAMP view's page list and the CHOP descriptor, the strings, and the RAM state (chop_on, chop_track, chop_pad, a spare byte, twelve 8.8 markers, twelve note-off routes, then the Sample Focus state) after every entry point. Run-time state stays here (cave has hardware evidence for it: the round-4 image ran with its state here)."
+note    = "The page_info / get / delta / text gates, the SAMPLE key gate, the pad note-on and note-off gates, the held-trig lock gate, chop_set_sta, the knob values and clamp, STR's value rows, the SAMP view's page list and the CHOP descriptor, and the RAM state (chop_on, chop_track, chop_pad, chop_end, twelve 8.8 markers, twelve note-off routes, chop_div, chop_str, chop_rng: 48 B at 0x402a1fc0) after every entry point. The strings are in the cave2 claim. Run-time state stays here (cave has hardware evidence for it: the round-4 image ran with its state here)."
 
 # Sample Focus (corp round r6, D22): CHOP's code that is not on the hot path - the
 # step lock and the Sample Focus features - in the part of cave2 that 0002 uses.
@@ -835,7 +848,7 @@ owner   = "0001-chop"
 addr    = 0x402a2780
 size    = 0x5b8
 section = ".cave2"
-note    = "chop_held_lock, chop_lock_step, chop_fn_mgr (round 4, moved), and the Sample Focus code (image A). No run-time state."
+note    = "chop_held_lock, chop_lock_step, chop_fn_mgr (round 4, moved), the Sample Focus code (image A) and the page and knob strings. No run-time state."
 
 # The SAMP view's page list: {4} becomes {4, 11}. Pressing SAMPLE again then
 # cycles to page 11 (with sample_key_gate below).
@@ -861,7 +874,7 @@ size   = 6
 expect = "720a202f0004"      # moveq #10,%d1; movel %sp@(4),%d0
 entry  = "page_info_gate"
 
-# The dials: page_get_value's entry, for ids 3..5.
+# The dials: page_get_value's entry, for CHOP's ids (3..5, 11..14, 2).
 [[detour]]
 owner  = "0001-chop"
 addr   = 0x400381a0
@@ -931,9 +944,10 @@ expect = "4fefffe848d7047c"
 entry  = "dial_gate"
 
 # The page view's held-trig / lock-source knob path (vtable slot 0x7c), which the
-# encoder handler calls instead of param_apply_delta while a trig is held: ids 3..5
-# return "not lockable", so a CHOP knob never writes a stock p-lock (0008 has no
-# such guard). lea %sp@(-48),%sp; moveml %d2-%d7/%a2-%a3,%sp@.
+# encoder handler calls instead of param_apply_delta while a trig is held: CHOP's
+# ids return 0 ("not lockable"), so a CHOP knob never writes a stock p-lock (0008 has
+# no such guard); RND (14) and STR (2) first take their own branches, which also
+# return 0. lea %sp@(-48),%sp; moveml %d2-%d7/%a2-%a3,%sp@.
 [[detour]]
 owner  = "0001-chop"
 addr   = 0x40038336
-- 
