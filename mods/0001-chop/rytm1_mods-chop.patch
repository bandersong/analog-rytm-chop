diff --git a/Makefile b/Makefile
index 65a672c..d35ec70 100644
--- a/Makefile
+++ b/Makefile
@@ -9,14 +9,28 @@ PY := python3
 # outputs in build/mk2/ named ARMK2_OS1.73_<tag>.syx. MK2 targets: control,
 # samplefocus (0000 lean + 0001 CHOP), samplefocus-cut (+ 0008 SMP CUT); the rest are
 # MK1-only and refuse.
+# DEVICE=keys builds for the Analog Keys (= Analog Four MK1), OS 1.56 (corp Keys chord
+# memory, TRUTH K1-K5): stock/KEYS_Analog-Four_Analog-Keys_OS1.56.syx (checked against
+# stock/SHA256SUMS.keys), re/symbols_keys.toml, registry/allocations_keys.toml, outputs
+# in build/keys/ named AKEYS_OS1.56_<tag>.syx. Keys target: control; every Analog
+# Rytm target refuses.
 DEVICE ?= mk1
 DEV := --device $(DEVICE)
 ifeq ($(DEVICE),mk1)
 MK1_ONLY :=
+RYTM_ONLY :=
+KEYS_ONLY = @echo "make $@ is Analog Keys only: make DEVICE=keys $@" >&2; exit 2
 # image A' on MK1: 0000-shared full, CHOP's .text in its own slot
 SAMPLEFOCUS_PARAMS :=
+else ifeq ($(DEVICE),keys)
+MK1_ONLY = @echo "make $@ is Analog Rytm MK1-only; DEVICE=keys builds control" >&2; exit 2
+RYTM_ONLY = @echo "make $@ is Analog Rytm only; DEVICE=keys builds control" >&2; exit 2
+KEYS_ONLY :=
+SAMPLEFOCUS_PARAMS :=
 else
 MK1_ONLY = @echo "make $@ is MK1-only; DEVICE=$(DEVICE) builds control, samplefocus and samplefocus-cut" >&2; exit 2
+RYTM_ONLY :=
+KEYS_ONLY = @echo "make $@ is Analog Keys only: make DEVICE=keys $@" >&2; exit 2
 # MK2 has one layout (registry/allocations_mk2.toml, layout A): 0000-shared is always
 # lean, for CHOP alone too
 SAMPLEFOCUS_PARAMS := --param 0000-shared:lean=1 --param 0001-chop:shared_lean=1
@@ -90,6 +104,7 @@ chop-min: symbols layout
 # chop-min, so both write build/AR1_OS1.73_0000_0001.syx.
 SAMPLEFOCUS_MODS := 0000-shared 0001-chop
 samplefocus: symbols layout
+	$(RYTM_ONLY)
 	$(PY) tools/build.py $(DEV) --mods $(SAMPLEFOCUS_MODS) $(SAMPLEFOCUS_PARAMS) --tag 0000_0001
 	$(PY) tools/verify.py $(DEV) --tag 0000_0001
 
@@ -100,6 +115,7 @@ samplefocus: symbols layout
 # together: the layout check refuses shared_lean = 1 with a full 0000-shared.
 SAMPLEFOCUS_CUT_MODS := 0000-shared 0001-chop 0008-sample-cut
 samplefocus-cut: symbols layout
+	$(RYTM_ONLY)
 	$(PY) tools/gen_cut_tables.py --check
 	$(PY) tools/build.py $(DEV) --mods $(SAMPLEFOCUS_CUT_MODS) --param 0000-shared:lean=1 \
 		--param 0001-chop:shared_lean=1 --tag 0000_0001_0008
@@ -131,6 +147,7 @@ guard-check: symbols layout
 	@echo "guard-check: PASS - all three builds refused, for the expected reason"
 
 # The pipeline test: no mods at all, stock MAIN OS recompressed by our tool.
+# (Every device: MK1, MK2 and the Analog Keys.)
 control: symbols layout
 	$(PY) tools/build.py $(DEV) --mods --tag control
 	$(PY) tools/verify.py $(DEV) --tag control
