+owner = "0000-shared"
+addr  = 0x402cdea0
+size  = 0x8c
+note  = "lean = 1: shared_rnd, shared_sound_of, shared_mark_changed, shared_mark_changed_set (PROJ_KIT = 352 on MK2). MK1: 0x402a2d98 (cave2)."
+
