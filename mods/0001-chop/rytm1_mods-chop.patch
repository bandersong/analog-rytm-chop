--- a/Makefile
+++ b/Makefile
@@ -2,6 +2,26 @@
 # Build and verify use only the Python standard library; python3 >= 3.11.
 PY := python3
 
+# Which Analog Rytm (tools/device.py). mk1 (the default) is the project as it always
+# was: every MK1 target builds byte for byte what it did. DEVICE=mk2 builds for the
+# Analog Rytm MKII, OS 1.73 (corp MK2 port, TRUTH D34-D38): stock/Analog-Rytm_MKII_OS1.73.syx
+# (checked against stock/SHA256SUMS.mk2), re/symbols_mk2.toml, registry/allocations_mk2.toml,
+# outputs in build/mk2/ named ARMK2_OS1.73_<tag>.syx. MK2 targets: control,
+# samplefocus (0000 lean + 0001 CHOP), samplefocus-cut (+ 0008 SMP CUT); the rest are
+# MK1-only and refuse.
+DEVICE ?= mk1
+DEV := --device $(DEVICE)
+ifeq ($(DEVICE),mk1)
+MK1_ONLY :=
+# image A' on MK1: 0000-shared full, CHOP's .text in its own slot
+SAMPLEFOCUS_PARAMS :=
+else
+MK1_ONLY = @echo "make $@ is MK1-only; DEVICE=$(DEVICE) builds control, samplefocus and samplefocus-cut" >&2; exit 2
+# MK2 has one layout (registry/allocations_mk2.toml, layout A): 0000-shared is always
+# lean, for CHOP alone too
+SAMPLEFOCUS_PARAMS := --param 0000-shared:lean=1 --param 0001-chop:shared_lean=1
+endif
+
 .PHONY: all setup symbols layout build verify random chop chop-min samplefocus samplefocus-cut guard-check elemod elemod-check control disasm clean
 
 all: verify
@@ -23,25 +43,28 @@ setup:
 	$(MAKE) -C $(EFT_DIR)
 
 symbols:
-	$(PY) tools/symbols.py
+	$(PY) tools/symbols.py $(DEV)
 
 layout:
-	$(PY) tools/layout.py
+	$(PY) tools/layout.py $(DEV)
 
 # The default build: the enabled mods (0000 0002 0003 0008). 0008 is built with its
 # own page gates (own_pages=1); its default 0 means 0001-chop owns them (image B),
 # which build.py refuses without 0001. The tag keeps the output names as they were.
 build: symbols layout
+	$(MK1_ONLY)
 	$(PY) tools/gen_cut_tables.py --check
 	$(PY) tools/build.py --param 0008-sample-cut:own_pages=1 --tag 0000_0002_0003_0008
 
 verify: build
+	$(MK1_ONLY)
 	$(PY) tools/verify.py $(if $(TAG),--tag $(TAG),)
 
 # The RANDOM build: 0004 LFO RND in place of 0008 SMP CUT (the two share the sound's
 # one free word, so they are never in one image).
 RANDOM_MODS := 0000-shared 0002-euclid-accents 0003-velocity-humanise 0004-lfo-rnd
 random: symbols layout
+	$(MK1_ONLY)
 	$(PY) tools/build.py --mods $(RANDOM_MODS) --tag 0000_0002_0003_0004
 	$(PY) tools/verify.py --tag 0000_0002_0003_0004
 
@@ -58,6 +81,7 @@ chop:
 # The CHOP bisection build: the shared runtime and CHOP alone.
 CHOP_MIN_MODS := 0000-shared 0001-chop
 chop-min: symbols layout
+	$(MK1_ONLY)
 	$(PY) tools/build.py --mods $(CHOP_MIN_MODS) --tag 0000_0001
 	$(PY) tools/verify.py --tag 0000_0001
 
@@ -66,8 +90,8 @@ chop-min: symbols layout
 # chop-min, so both write build/AR1_OS1.73_0000_0001.syx.
 SAMPLEFOCUS_MODS := 0000-shared 0001-chop
 samplefocus: symbols layout
-	$(PY) tools/build.py --mods $(SAMPLEFOCUS_MODS) --tag 0000_0001
-	$(PY) tools/verify.py --tag 0000_0001
+	$(PY) tools/build.py $(DEV) --mods $(SAMPLEFOCUS_MODS) $(SAMPLEFOCUS_PARAMS) --tag 0000_0001
+	$(PY) tools/verify.py $(DEV) --tag 0000_0001
 
 # Sample Focus image B (corp round 7, D25-D29): image A' plus 0008 SMP CUT. CHOP owns
 # the page hosts and hands 0008's ids 1..2 and page 12 to it (0008 own_pages = 0, its
@@ -77,9 +101,9 @@ samplefocus: symbols layout
 SAMPLEFOCUS_CUT_MODS := 0000-shared 0001-chop 0008-sample-cut
 samplefocus-cut: symbols layout
 	$(PY) tools/gen_cut_tables.py --check
-	$(PY) tools/build.py --mods $(SAMPLEFOCUS_CUT_MODS) --param 0000-shared:lean=1 \
+	$(PY) tools/build.py $(DEV) --mods $(SAMPLEFOCUS_CUT_MODS) --param 0000-shared:lean=1 \
 		--param 0001-chop:shared_lean=1 --tag 0000_0001_0008
-	$(PY) tools/verify.py --tag 0000_0001_0008
+	$(PY) tools/verify.py $(DEV) --tag 0000_0001_0008
 
 # The mods as elekloader .elemod files (build/elemod/), one per mod, from the two
 # verified builds. elemod-check proves that elekloader, given them, builds the same
@@ -87,6 +111,7 @@ samplefocus-cut: symbols layout
 # ELEKLOADER= points at an elekloader checkout with the Analog Rytm mk1 profile.
 ELEKLOADER ?= ../elekloader
 elemod:
+	$(MK1_ONLY)
 	$(PY) tools/mkelemod.py
 elemod-check: elemod
 	$(PY) tools/elemod_check.py --elekloader $(ELEKLOADER) --full
@@ -96,6 +121,7 @@ elemod-check: elemod
 # nothing), 0008 without 0000-shared (it would assemble against no shared.inc), and
 # 0001's shared_lean = 1 with a full 0000-shared (CHOP's .text would run into it).
 guard-check: symbols layout
+	$(MK1_ONLY)
 	$(PY) tools/build.py --mods 0000-shared 0008-sample-cut --tag guard_a 2>&1 \
 		| grep -q "exist only through 0001-chop's gates"
 	$(PY) tools/build.py --mods 0008-sample-cut --param 0008-sample-cut:own_pages=1 \
@@ -106,12 +132,13 @@ guard-check: symbols layout
 
 # The pipeline test: no mods at all, stock MAIN OS recompressed by our tool.
 control: symbols layout
-	$(PY) tools/build.py --mods --tag control
-	$(PY) tools/verify.py --tag control
+	$(PY) tools/build.py $(DEV) --mods --tag control
+	$(PY) tools/verify.py $(DEV) --tag control
 
 # Whole-image disassembly with EMAC decoding.
 MAINOS_BASE := 0x40000400
 disasm: build
+	$(MK1_ONLY)
 	printf '\t.section .archtag,"a"\n\tmovclr.l %%acc0,%%d0\n\t.text\n\t.incbin "build/stock_mainos.bin"\n' \
 		> build/mainos_wrap.s
 	$$($(PY) -c 'import sys; sys.path.insert(0,"tools"); from toolchain import prefix; print(prefix())')as \
diff --git a/re/symbols_mk2.toml b/re/symbols_mk2.toml
new file mode 100644
index 0000000..beb8241
--- /dev/null
+++ b/re/symbols_mk2.toml
@@ -0,0 +1,327 @@
+# Analog Rytm MKII symbol map, OS 1.73 - what 0000-shared (lean), 0001-chop and
+# 0008-sample-cut (own_pages = 0, diag = 0) need for the MK2 Sample Focus builds
+# (corp MK2 port, TRUTH D34-D38; `make DEVICE=mk2 control|samplefocus|samplefocus-cut`).
+#
+# Addresses are virtual (load base 0x40000400); file_offset = addr - 0x40000400.
+# mk1 = the MK1 1.73 twin (re/symbols.toml). Sources: the corp MK2 RE lanes and
+# their skeptics (corp-audits/2026-10-05-rytm-chop/corp/mk2-re/results.json; the
+# per-lane files mk2-addrA, mk2-addrB, mk2-geometry, mk2-space and mk2-sk-*): every
+# address was matched MK1 -> MK2 with tools/xmatch.py's normalisation, read side by
+# side in both disassemblies (MK2: build/mk2-1.73/mainos_mk2_1.73_emac.dis, dis:N =
+# its line N) and re-derived by a skeptic (entry-to-rts compare with immediates kept,
+# reference-context alignment). A skeptic correction wins over its lane. Each
+# detour/patch expect in registry/allocations_mk2.toml was re-read from the MK2 MAIN
+# OS and is asserted again by tools/build.py before patching.
+#
+# status = "verified": found in the MK2 image and confirmed by the lane's skeptic.
+
+[meta]
+target        = "OS1.73"
+device        = "Analog Rytm MKII"
+base          = 0x40000400
+mainos_size   = 3005432
+mainos_sha256 = "28d9ef40c895e03f17dfce096543109adaf708947392db72818fc2a412d685d6"
+
+# The never-write range: the MK2 twin of MK1's embedded-bootstrap rule (TRUTH D35;
+# corp mk2-space lane and its skeptic). Where MK1 embeds its bootstrap, MK2 embeds two
+# firmware images for another device: an MK2-only updater (0x401006fc -> 0x4013fe9c ->
+# 0x4013fd32) sends them at startup, when their version words (+4) differ from the
+# device's, through the register block at 0xec070000. The exact bounds are immediates
+# in that code (dis:409323-409351): 'movel #0x402cc91c,%d0; subil #0x402cb47c' (image 2
+# = 0x402cb47c..0x402cc91c) and 'movel #0x402cb47c,%d0; subil #0x402c8754' (image 1 =
+# 0x402c8754..0x402cb47c); the last non-zero byte is 0x402cc91b. No pool, claim, patch
+# or detour may touch it (tools/layout.py), and build.py and verify.py hold it to the
+# stock hash. Which device receives it is UNKNOWN; the rule holds regardless.
+never_write_name   = "embedded device firmware"
+never_write_start  = 0x402c8754
+never_write_end    = 0x402cc91c          # exclusive
+never_write_sha256 = "eea392278e89a265630a2f71eca2b65afdddeaddf3cf91a187ec4f40dc866b52"
+
+# ColdFire with EMAC (voice_out uses mac/msac and leaves MACSR 0x20), assembled as the
+# MKII project did: -mcpu=5475, plus -mno-float so an FPU instruction is an assembly
+# error rather than a guess.
+cpu = "5475"
+cpu_flags = ["-mno-float"]
+
+# The MKII container (ELE3) carries five sections: FPGA (1), bootstrap (2), MAIN OS
+# (3), meta (5, raw) and section 8. Only MAIN OS is ever rebuilt (TRUTH D32); the
+# others must come back from every build byte for byte (tools/verify.py) - the
+# bootstrap, MK2's recovery path and a separate section here, above all. These are
+# the checksums of stock's sections as tools/build.py extracts them.
+[meta.other_sections]
+"section_1_FPGA.bin"      = "7c8bff3cb411ed93434b3a4eab846738be6241d64aeb23b4061eb11a8aa29b2f"
+"section_2_bootstrap.bin" = "1b8d3b7288df118512740ac7c59d8dd9f71f44e6633a29628bcb068d756e2ed8"
+"section_5_meta.raw"      = "760128764787e148ed16af6987765618289616e4a44ad2f37a32297e5732659d"
+"section_8_?.bin"         = "6943b2f27773f40f1e7857ea6fa7a121269e930bd403098e6b6c00002327dc20"
+
+# ======================================================================== core
+[fn.project_singleton]
+addr = 0x4017f83e
+mk1 = 0x401556cc
+status = "verified"
+evidence = "mk2-addrA + mk2-sk-addrA CONFIRMED: entry-to-rts 43/43 instr (1 diff = the object size), body unique on both, 408 reference contexts aligned with 0 disagreeing. Lazy singleton on project_instance 0x419f28a8 (dis:485928 tstl 0x419f28a8)."
+
+[fn.track_index_of]
+addr = 0x400b68d2
+mk1 = 0x400b3a04
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: entry-to-rts 20/20 instr, 0 strict diffs; 99 reference contexts aligned, 0 disagree. param_apply_delta calls it at 0x400378bc after 'movel %a2@(116),%sp@-' (dis:71992)."
+
+[fn.kit_track_sound]
+addr = 0x400a675e
+mk1 = 0x400a3d08
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: entry-to-rts 14/14, 0 strict diffs (clamp 0..11, kit + 0x60 + 352*t). mk2-geometry/skeptic: kit+0x60, stride 352 (extension word 0x0860), 12 sounds."
+
+[fn.kit_param_changed]
+addr = 0x4003355c
+mk1 = 0x40033438
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: entry-to-rts 51/51, 0 strict diffs; both stock call sites aligned. mk2-addrB: shared_mark_changed's chain (view vtable +0xa0, parameter set +4 bank / +8 track) unchanged."
+
+[fn.is_key_held]
+addr = 0x40081bbc
+mk1 = 0x4008022e
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: entry-to-rts 18/18, 0 strict diffs; the UI loop's pad cases call it with pea 0x80 (dis:210867-210869)."
+
+[const.KEY_FUNC]
+value = 0x80
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: MK2 dis:210867 pea 0x80 + jsr 0x40081bbc, as MK1."
+
+[data.project_instance]
+addr = 0x419f28a8
+mk1 = 0x416c70c0
+status = "verified"
+evidence = "mk2-sk-addrA/mk2-sk-addrB CONFIRMED: project_singleton tests and stores it (dis:485928, 485953; also 0x400bf4a0 and 0x4013c30a store it). 0008's cut_process reads the project pointer here."
+
+# ================================================================= page hosts
+[fn.param_info]
+addr = 0x400ff556
+mk1 = 0x400f8718
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: 9/9 instr, 1 diff = the stride (moveq #84, dis:330710); returns 0x419a4888 + 84*id for id < 469."
+
+[fn.page_info]
+addr = 0x400ff574
+mk1 = 0x400f8736
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: 11/11 instr, 1 diff = the page bound: 'moveq #11,%d1' (dis:330714), pages 0..11, descriptors at 0x4028843c + 36*id, else 0x401ec570. The CHOP/0008 detour host (displaced 720b202f0004)."
+
+[data.page_info_resume]
+addr = 0x400ff57a
+mk1 = 0x400f873c
+status = "verified"
+evidence = "Entry + 6: 'cmpl %d0,%d1' (dis:330716); no MK2 branch target inside 0x400ff574..0x400ff579 (mk2-sk-addrA)."
+
+[data.page_get_value_body]
+addr = 0x4003846a
+mk1 = 0x400381a8
+status = "verified"
+evidence = "page_get_value (0x40038462, SAMP vtable slot 0x54) + 8; displaced 4feffff448d7040c identical to MK1 (mk2-sk-addrA, raw)."
+
+[data.param_apply_delta_track]
+addr = 0x400378bc
+mk1 = 0x400376ea
+status = "verified"
+evidence = "param_apply_delta (0x400378a6, SAMP vtable slot 0x58) + 22, 'jsr 0x400b68d2' after the displaced 77832f2a0074. Caller pushes (view, id, delta, FUNC, &lockout) as on MK1 (mk2-sk-addrA ADDED: MK2 dis:75385-75391)."
+
+[data.param_value_text_args]
+addr = 0x400a85f8
+mk1 = 0x400a5910
+status = "verified"
+evidence = "param_value_text (0x400a85e0) + 24, after the displaced 242f0020262f0024 (mk2-sk-addrA). Later in the routine the record fields shift (+32->+28 etc., mk2-sk-addrB); the gates read none of them."
+
+[data.lock_delta_body]
+addr = 0x40038600
+mk1 = 0x4003833e
+status = "verified"
+evidence = "view_lock_delta (0x400385f8, SAMP vtable slot 0x7c) + 8: 'moveal %sp@(52),%a3' (dis:73109); body 152/152 instr identical (mk2-sk-addrA)."
+
+[fn.view_invalidate]
+addr = 0x40078514
+mk1 = 0x40076c14
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: 10/10 instr, 0 strict diffs; 168 contexts aligned."
+
+[fn.view_refresh_request]
+addr = 0x4007854c
+mk1 = 0x40076c4c
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: 8/8 instr, 0 strict diffs; 21 contexts aligned."
+
+# ============================================================ sound parameters
+[fn.param_set_value]
+addr = 0x400a9000
+mk1 = 0x400a6316
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: entry-to-rts 72/72 instr, 0 strict diffs; (set, id, value 8.8, track, record, notify) as MK1."
+
+[fn.project_kit]
+addr = 0x400ae45e
+mk1 = 0x400ab706
+status = "verified"
+evidence = "mk2-sk-addrA/mk2-sk-addrB CONFIRMED: 'addil #352,%d0' (dis:223964) - the active kit is at project + 352 on MK2 (MK1 + 232). 0000-shared PROJ_KIT and 0008 SOUND0 follow (352, 448)."
+
+[fn.project_selection]
+addr = 0x400ae426
+mk1 = 0x400ab6ce
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: 3/3 instr, 0 strict diffs (project + 48)."
+
+[fn.kit_track_param_set]
+addr = 0x400a6422
+mk1 = 0x400a39fa
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: 22/22 instr, 0 strict diffs (kit + 4320 + 28*T, FX set for T >= 12, mk2-geometry)."
+
+[fn.sample_pos_res]
+addr = 0x400fabc0
+mk1 = 0x400f3cfc
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: getter of the SAMPLE POS RES byte 0x405c8e83 (settings block 0x405c8e10 + 0x73), anchored by the identical setter after it (dis:324578-324591); the encoder's 43..44 LO test calls it (dis:75224-75232). d0 only."
+
+[fn.sta_value_text]
+addr = 0x400fbad8
+mk1 = 0x400f4cbc
+status = "verified"
+evidence = "mk2-sk-addrA CONFIRMED: installed by the static ctor as record 43's text functor (dis:533694-533697), args (functor, value 8.8, buf) unchanged. DIFFERS in output: whole values print '%d' (0x4025b683), others '%d.%02d' (0x40258699) - two decimals where MK1 prints one."
+
+[data.param_tmpl_sta]
+addr = 0x401ed03c
+mk1 = 0x401ba300
+status = "verified"
+evidence = "Record 43's (STA's) 16-byte encoder template, copied to its RAM record +4 by the static ctor (dis:535138-535144: pea 0x10; movel #0x401ed03c). Raw {1, 0x40, 0, 0x417e3800}: +0x10 is the curve the encoder copies (0x1c B, dis:75258-75263). MK1's is 20 B {2,0x800,8,0,0x50}."
+
+[data.param_tmpl_default]
+addr = 0x401ed07c
+mk1 = 0x401ba38c
+status = "verified"
+evidence = "The default 16-byte template, kept in %d2 by the static ctor (dis:534504 movel #0x401ed07c,%d2) and copied to record 4 +4 (dis:534566-534569: pea 0x10; pea 0x419a49dc). Raw {1, 2, 0, 0x417e37e4}: the curve the encoder forces for 43..44 under SAMPLE POS RES = LO (dis:75327-75330)."
+
+[data.PARAM_INFO_BASE]
+addr = 0x419a4888
