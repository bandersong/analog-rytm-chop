@@ -14,7 +14,8 @@ mk2  Analog Rytm MKII, OS 1.73 (corp MK2 port, TRUTH D34-D38). Its own stock .sy
      with DEVICE_MK2 defined (`.ifdef DEVICE_MK2` selects the MK2 constants).
 
 Never-write ranges inside MAIN OS come from the symbol map's [meta]: MK1's embedded
-bootstrap (embedded_bootstrap_*), MK2's embedded device firmware (never_write_*).
+bootstrap (embedded_bootstrap_*), MK2's embedded device firmware (never_write_*). A map
+without its device's range is refused (Device.check_meta), never checked vacuously.
 """
 
 from pathlib import Path
@@ -30,6 +31,10 @@ PROFILES = {
         "build": "build",
         "syx_prefix": "AR1",
         "defsyms": [],
+        # the [meta] key its never-write range starts with, and whether [meta] must list
+        # the container's other sections (check_meta)
+        "never_write_key": "embedded_bootstrap_start",
+        "other_sections": False,
     },
     "mk2": {
         "stock": "stock/Analog-Rytm_MKII_OS1.73.syx",
@@ -39,6 +44,8 @@ PROFILES = {
         "build": "build/mk2",
         "syx_prefix": "ARMK2",
         "defsyms": ["DEVICE_MK2=1"],
+        "never_write_key": "never_write_start",
+        "other_sections": True,
     },
 }
 
@@ -56,6 +63,27 @@ class Device:
         self.build = ROOT / p["build"]
         self.syx_prefix = p["syx_prefix"]
         self.defsyms = list(p["defsyms"])
+        self.never_write_key = p["never_write_key"]
+        self.needs_other_sections = p["other_sections"]
+
+    def check_meta(self, meta):
+        """Refuse a symbol map whose [meta] lacks this device's never-write range.
+
+        protected() returns [] for a [meta] with no range keys, and every check that
+        loops over it (layout, build, verify) would then pass without checking anything
+        (corp mk2-panel-brick b1; before devices, a missing key raised KeyError). MK1
+        must carry its embedded bootstrap, MK2 its embedded device firmware and the
+        checksums of its other container sections. Prints nothing when the map is
+        complete, so a build's output is as before.
+        """
+        where = self.symbols.relative_to(ROOT)
+        if self.never_write_key not in meta or not protected(meta):
+            raise SystemExit(f"{where} [meta] has no {self.never_write_key}: the {self.name} "
+                             f"never-write range would go unchecked - refusing")
+        if self.needs_other_sections and not meta.get("other_sections"):
+            raise SystemExit(f"{where} [meta] has no other_sections: the {self.name} "
+                             f"container's other sections (its bootstrap) would go unchecked "
+                             f"- refusing")
 
 
 def add_arg(ap):
