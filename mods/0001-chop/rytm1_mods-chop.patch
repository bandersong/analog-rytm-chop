@@ -0,0 +1,82 @@
+"""Which Analog Rytm a build is for: its stock .syx, symbol map, registry and build directory.
+
+Every tool takes `--device mk1|mk2` (the Makefile passes DEVICE, default mk1).
+
+mk1  Analog Rytm MK1, OS 1.73 - the project as it always was. Every path and name
+     below is the one the tools used before devices existed, so an MK1 build is byte
+     for byte what it was (corp MK2 port, TRUTH D34: samplefocus 23a20937...,
+     samplefocus-cut 86e1dd1b..., control 3407638c...).
+mk2  Analog Rytm MKII, OS 1.73 (corp MK2 port, TRUTH D34-D38). Its own stock .syx
+     (an ELE3 container: FPGA, bootstrap, MAIN OS, meta and section 8; only MAIN OS,
+     section 3, is ever rebuilt), its own symbol map (re/symbols_mk2.toml) and registry
+     (registry/allocations_mk2.toml), and its own build directory, build/mk2/, so no
+     MK1 file is ever read or overwritten by an MK2 build. Its stubs are assembled
+     with DEVICE_MK2 defined (`.ifdef DEVICE_MK2` selects the MK2 constants).
+
+Never-write ranges inside MAIN OS come from the symbol map's [meta]: MK1's embedded
+bootstrap (embedded_bootstrap_*), MK2's embedded device firmware (never_write_*).
+"""
+
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+PROFILES = {
+    "mk1": {
+        "stock": "stock/Analog-Rytm_OS1.73.syx",
+        "sums": "stock/SHA256SUMS",
+        "symbols": "re/symbols.toml",
+        "registry": "registry/allocations.toml",
+        "build": "build",
+        "syx_prefix": "AR1",
+        "defsyms": [],
+    },
+    "mk2": {
+        "stock": "stock/Analog-Rytm_MKII_OS1.73.syx",
+        "sums": "stock/SHA256SUMS.mk2",
+        "symbols": "re/symbols_mk2.toml",
+        "registry": "registry/allocations_mk2.toml",
+        "build": "build/mk2",
+        "syx_prefix": "ARMK2",
+        "defsyms": ["DEVICE_MK2=1"],
+    },
+}
+
+
+class Device:
+    def __init__(self, name: str):
+        if name not in PROFILES:
+            raise SystemExit(f"unknown device {name!r}: one of {', '.join(sorted(PROFILES))}")
+        p = PROFILES[name]
+        self.name = name
+        self.stock_syx = ROOT / p["stock"]
+        self.sums = ROOT / p["sums"]
+        self.symbols = ROOT / p["symbols"]
+        self.registry = ROOT / p["registry"]
+        self.build = ROOT / p["build"]
+        self.syx_prefix = p["syx_prefix"]
+        self.defsyms = list(p["defsyms"])
+
+
+def add_arg(ap):
+    ap.add_argument("--device", default="mk1", choices=sorted(PROFILES),
+                    help="which Analog Rytm (default mk1)")
+
+
+def protected(meta):
+    """[(label, start, end_exclusive, sha256)] - the MAIN OS ranges no build may change.
+
+    MK1: the embedded bootstrap image (the recovery path, self-flashed by the OS).
+    MK2: the embedded device firmware the OS sends to another device at startup (corp
+    mk2-space lane, TRUTH D35); MK2's bootstrap is a separate container section, which
+    verify.py compares whole.
+    """
