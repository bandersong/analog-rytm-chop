From fd3b07b5a7042bc5af2d8bbf97246f1fbc6fbb4e Mon Sep 17 00:00:00 2001
From: bandersong <134746909+bandersong@users.noreply.github.com>
Date: Wed, 7 Oct 2026 22:23:45 -0400
Subject: [PATCH 29/44] MK2 step 3: Sample Focus + SMP CUT on the MKII (make
 DEVICE=mk2 samplefocus-cut; D36, D37)

0000-shared lean + 0001-chop + 0008-sample-cut (own_pages = 0, diag = 0) for
Analog Rytm MKII 1.73, built and verified in the guest: PASS (null repack,
round trip, the four other sections byte-identical, embedded device firmware
unchanged, 29 differing regions all claimed).

0008 on MK2 (.ifdef DEVICE_MK2, MK1 bytes unchanged): SOUND0 = 352 + 96 = 448,
FILTER is page 6 and SMP CUT page 13 (CHOP's gates answer it through
shared_cut_page_id); FILTER list {6, 13} (count 0x400caf82 7201 -> 7202, list
word 0x400caf88 expect 401e1b1c); the audio interrupt's two voice_out call words
0x4011fdb8 / 0x40121230 (expect 4010ea2c, the only two in the image) point at
voice_out_gate; voice_owner 0x40290dd8, project_instance 0x419f28a8; ROM ids 1-2
renamed at MK1 + 0x31914. Layout A: .text 810 B and .cutst 128 B in cave, .tab
937 B in cave3. MK2's FILTER view draws through 0x400d2e1a, which adds extras
only for page ids 6/7, so page 13 needs no draw gate. 0008's MK2 claims are gated
!own_pages and its patches are not: an MK2 own_pages = 1 build is refused at
its first from_symbol patch, never built without 0008.

MK1 outputs unchanged (guest): samplefocus 23a20937..., samplefocus-cut
86e1dd1b..., control 3407638c..., default 0d51f7cb..., random 3dafc0bd...;
manifests identical; guard-check PASS.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 mods/0008-sample-cut/stub.s   |  30 ++++++-
 registry/allocations_mk2.toml | 150 ++++++++++++++++++++++++++++++++++
 2 files changed, 179 insertions(+), 1 deletion(-)

diff --git a/mods/0008-sample-cut/stub.s b/mods/0008-sample-cut/stub.s
index 9183758..4077407 100644
--- a/mods/0008-sample-cut/stub.s
+++ b/mods/0008-sample-cut/stub.s
@@ -41,12 +41,33 @@
         | handlers for ids 1..2 and answer page 12 with its descriptor, through
         | the shared_cut_* labels (build/shared.inc; this mod is a provider).
         | tools/build.py refuses P_OWN_PAGES = 0 without 0001-chop enabled.
+        |
+        | Analog Rytm MKII 1.73 (DEVICE_MK2: `make DEVICE=mk2 samplefocus-cut`,
+        | corp MK2 port, TRUTH D34-D38; image B form only, P_OWN_PAGES = 0 and
+        | P_DIAG = 0). The same code with the MKII addresses (re/symbols_mk2.toml:
+        | voice_out 0x4010ea2c, voice_owner 0x40290dd8, project_instance
+        | 0x419f28a8) and three values, selected by .ifdef DEVICE_MK2 so the MK1
+        | bytes stay as they were: the kit is at project + 352 (SOUND0 = 448);
+        | FILTER is page 6 (5 is MK2's SMPL WAVEFORM); SMP CUT is page 13 (stock
+        | pages 0..11, CHOP 12). The Sound layout (kit + 0x60, stride 352, live
+        | +16, the free word at +0x14), the voice mixer's call frame and its DAC
+        | ring (8 voices x 32 frames, 64-byte stride, txbase 0x80000000 + slot <<
+        | 11, MACSR 0x20 on exit) are MK1's (corp mk2-addrB/geometry, skeptic-
+        | confirmed). Sections per layout A (registry/allocations_mk2.toml): .text
+        | and .cutst (the filter state) in `cave`, .tab in cave3.
 
         .include "symbols.inc"
         .include "shared.inc"
 
+        .ifdef  DEVICE_MK2
+        .equ    PAGE_FILT,      6                 | MK2: 5 is SMPL WAVEFORM (list 0x401e1b1c = {6})
+        .equ    PAGE_CUT,       13                | MK2 pages are 0..11; CHOP is 12
+        .equ    PAGE_LAST,      11                | page_info's displaced moveq
+        .else
         .equ    PAGE_FILT,      5
         .equ    PAGE_CUT,       12                | MK1 pages are 0..10; CHOP is 11
+        .equ    PAGE_LAST,      10                | page_info's displaced moveq
+        .endif
         .equ    ID_LC,          1
         .equ    ID_HC,          2
         .equ    OFF_PARAMS,     0x14              | live sound parameter array
@@ -67,7 +88,14 @@
         | this->+16`. MK1 1.73 (corp r5b-offsets O1-O3, skeptic-confirmed): the
         | first build had 352+60, read objdump's hex '60' as decimal and took the
         | MKII kit offset, so it read Sound_T + 100 instead of the live sound.
+        | MK2 1.73: the kit is at project + 352 (project_kit 0x400ae45e 'addil
+        | #352'), the rest of the chain as on MK1 (corp mk2-addrB/geometry, skeptic-
+        | confirmed): SOUND0 = 352 + 96 = 448.
+        .ifdef  DEVICE_MK2
+        .equ    SOUND0,         352+96            | the kit's first Sound, from the project (448)
+        .else
         .equ    SOUND0,         232+96            | the kit's first Sound, from the project (328)
+        .endif
         .equ    SOUND_STRIDE,   352
         .equ    SOUND_LIVE,     16
 
@@ -93,7 +121,7 @@ page_info_gate:
         lea     page_cut,%a0
         move.l  %a0,%d0
         rts
-1:      moveq   #10,%d1                           | displaced
+1:      moveq   #PAGE_LAST,%d1                    | displaced (MK1 #10, MK2 #11)
         move.l  %sp@(4),%d0                       | displaced
         jmp     page_info_resume
         .endif
