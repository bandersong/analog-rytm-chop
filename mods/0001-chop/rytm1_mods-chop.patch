diff --git a/re/symbols_keys.toml b/re/symbols_keys.toml
new file mode 100644
index 0000000..f1330ae
--- /dev/null
+++ b/re/symbols_keys.toml
@@ -0,0 +1,47 @@
+# Analog Keys symbol map, OS 1.56 (corp Keys chord memory, TRUTH K1-K5;
+# `make DEVICE=keys control|chord`). The Analog Keys and the Analog Four MK1 run the
+# same OS image (device byte 0x06).
+#
+# Addresses are virtual (load base 0x40000400); file_offset = addr - 0x40000400. The
+# disassembly these were read from is build/keys-1.56/mainos_keys_1.56_emac.dis of the
+# parent repo ("dis:N" = its line N). Sources: the corp Keys RE lanes and their skeptics
+# (corp-audits/2026-10-05-rytm-chop/corp/keys-re/results.json: keys-platform, keys-notes
+# and their skeptics; corp keys-gesture + keys-gesture-sk). A skeptic correction wins
+# over its lane. Each detour expect in registry/allocations_keys.toml was re-read from
+# this MAIN OS and is asserted again by tools/build.py before patching.
+#
+# status = "verified": read in the Keys image and confirmed by the lane's skeptic.
+
+[meta]
+target        = "OS1.56"
+device        = "Analog Keys"
+base          = 0x40000400
+mainos_size   = 2372584
+mainos_sha256 = "cc19347b11d220aba73e4fd7203b2ce4e6d6d9553308d713648885682c714c26"
+
+# Never-write range 1: the embedded bootstrap, the twin of the MK1 Rytm's (corp
+# keys-platform P2, skeptic CONFIRMED). At reset 0x40000e6a compares the version word at
+# 0x40226ee8 with flash 0xfff8; when flash is lower, 0x40100b70 shows BOOTSTRAP UPGRADE,
+# erases 8 KB sectors 0..7, copies the halfwords 0x40226ef0..0x40233fc0 (exclusive bound:
+# 'cmpil #0x40233fc0,%d4' at 0x40100c68) to flash 0x0 and then writes 0x40226ee8/ea to
+# 0xfff8/0xfffa. A mod byte here could one day be written into the recovery path.
+embedded_bootstrap_start  = 0x40226ee8
+embedded_bootstrap_end    = 0x40233fc0   # exclusive; 53,464 B
+embedded_bootstrap_sha256 = "24c04cc5000b893c4faf0bda2db559ce4971a1b3df91f612bcd5fb48dffb5924"
+
+# Never-write range 2 (Keys only, no Rytm twin): the embedded UI-board firmware (corp
+# keys-platform P3, skeptic CONFIRMED with corrections). Reset also calls 0x40100f7c,
+# which, when bit 20 of the bootloader word 0x401d8ea4 is set and its top byte is 0, 1 or
+# 3, shows 'UI UPGRADE' and sends 0x401b8a92 + 0x1544 bytes through 0x40100ed4 (magic
+# 0xb00fb00f, a checksum, the type, the byte length, then the words). Its receiver is
+# UNKNOWN; the rule holds regardless.
+never_write_name   = "embedded UI-board firmware"
+never_write_start  = 0x401b8a92
+never_write_end    = 0x401b9fd6          # exclusive; 5,444 B
+never_write_sha256 = "6b57f97446fef103cc265768370c79cb7da5fb79fe25b5ebd563610195ed23e4"
+
+# ColdFire, the same startup CACR constants as the MK1 Rytm (keys-platform C2); assembled
+# like the Rytm builds: -mcpu=5475 plus -mno-float, so an FPU instruction is an assembly
+# error rather than a guess.
+cpu = "5475"
+cpu_flags = ["-mno-float"]
diff --git a/registry/allocations_keys.toml b/registry/allocations_keys.toml
new file mode 100644
index 0000000..2ca483b
--- /dev/null
+++ b/registry/allocations_keys.toml
@@ -0,0 +1,100 @@
+# Single source of truth for every scarce resource a mod can claim - Analog Keys
+# (= Analog Four MK1), OS 1.56 (corp Keys chord memory, TRUTH K1-K5; `make DEVICE=keys
+# ...`). The same rules as the Rytm registries: tools/layout.py asserts that no two
+# claims overlap, that every claim sits inside its pool and that nothing touches either
+# never-write range; tools/build.py checks every `expect` against the stock Keys MAIN OS
+# bytes before patching.
+#
+# Every address below is a Keys address (load base 0x40000400), read from the Keys 1.56
+# MAIN OS (sha256 cc19347b...4c26) and its disassembly (parent repo
+# build/keys-1.56/mainos_keys_1.56_emac.dis, "dis:N" = line N).
+#
+# owner = the mod directory name, or "reserved:<reason>".
+
+[meta]
+target = "OS1.56"
+device = "Analog Keys"
+
+# ---------------------------------------------------------------- the image
+#
+# corp keys-platform lane and its skeptic (all static, on this image):
+#   Startup copies 0x40235000..0x4023c4a8 to SRAM 0x80000000 and 0x4023c4a8..0x402437e8
+#   to 0x80008000, then zeroes 0x40235000..0x4260fb10: __bss_start = 0x40235000. The
+#   image runs from SDRAM, so .data variables live below __bss_start too (stock stores
+#   to 0x40226ee0/e4 and 0x401f1a08): "below bss" alone does not mean unused.
+#   The C++ static-constructor table: count 122 at 0x4023466c, entries from 0x40234670,
+#   ending exactly at 0x40234858 (last entry 0x4016775c).
+#
+# THE TWO KEYS TRAPS (re/symbols_keys.toml [meta]): the embedded bootstrap
+# 0x40226ee8..0x40233fc0 (self-flashed by the OS, the recovery path) and the embedded
+# UI-board firmware 0x401b8a92..0x401b9fd6 (sent to another processor at startup). No
+# pool may touch either; layout.py refuses any claim, patch or detour that does, and
+# build.py and verify.py hold both to their stock hashes in every build.
+#
+# Free space is much tighter than on the Rytm (keys-platform P7): there is no Rytm-style
+# `cave` after the bootstrap (only 64 B before the USB strings at 0x40234000), and the
+# zero run 0x40233c18..0x40233ee0 is INSIDE the bootstrap image. 0x401f11f8..0x401f1a08
+# is the zero tail of a live table whose last word stock reads. Referenced zero runs
+# examined and rejected (keys-sk-platform P7): 0x402266de..0x40226a4c (3 pointers inside)
+# and 0x401ed961..0x401eda67 (1 pointer inside).
+
+# ---------------------------------------------------------------------- pools
+
+[[pool]]
+name   = "cave2"
+start  = 0x4023485c
+end    = 0x40235000          # exclusive; 1956 B
+status = "probably-verified"
+note   = """
+The Keys twin of the MK1 Rytm's cave2 (corp keys-platform P5, skeptic CONFIRMED): the
+zeros between the end of the static-constructor table (122 entries, ending 0x40234858)
+and __bss_start 0x40235000. Starts 4 bytes in to keep claims aligned, as on MK1.
+
+Evidence, all static, on this image:
+- 0x40234858..0x40235000 is 1960 zero bytes (keys-platform zeroruns.py; re-read by the
+  Keys builder, corp keys-builder: raw bytes all zero).
+- No 32-bit word at any even offset in the image points into 0x40234858..0x40235000
+  (keys-sk-platform wordscan.py; the Keys builder's own scan of the raw MAIN OS: 0 hits).
+- The constructor loop 0x400ffbfe reads its count (122) from 0x4023466c and stops at
+  0x40234858, so nothing reads the pool as a table; 0x40235000's users (0x40003a20/
+  0x40003a54) index upward only.
+- 0x40235000 is where both the SRAM copy and the .bss clear start; the pool is below
+  both, so nothing clears or reuses it at run time.
+
+Status. The keys-platform lane and its skeptic proposed "candidate" until a Keys
+hardware run. This registry applies the rule the MK1 registry wrote for its own cave2
+(registry/allocations.toml, cave2 note: "the static case is complete, not an argument"
